<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Eredivisie{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚽</text></svg>">

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        <nav class="navbar bg-dark" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">⚽ Eredivisie</a>
            </div>
        </nav>

        <main class="container py-4 flex-grow-1">
            {% block body %}{% endblock %}
        </main>

        <footer class="border-top py-3 text-center text-body-secondary small">
            Data: <a href="https://www.football-data.org" class="link-secondary">football-data.org</a>
        </footer>
    </body>
</html>
