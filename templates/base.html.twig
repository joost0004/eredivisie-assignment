<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Fulltime{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><rect width=%2216%22 height=%2216%22 fill=%22%23416180%22/></svg>">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;700&family=Barlow+Condensed:wght@600&display=swap">

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        <nav class="navbar border-bottom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fs-4" href="{{ path('app_team_index') }}">
                    <span class="d-inline-block p-2 bg-primary"></span>Fulltime
                </a>
                <ul class="navbar-nav flex-row gap-4 me-auto">
                    <li class="nav-item">
                        {% if app.request.attributes.get('_route') starts with 'app_team' %}
                            <a class="nav-link active" href="{{ path('app_team_index') }}">Teams</a>
                        {% else %}
                            <a class="nav-link" href="{{ path('app_team_index') }}">Teams</a>
                        {% endif %}
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    {% if app.user %}
                        <span class="small text-body-secondary d-none d-sm-inline">{{ app.user.userIdentifier }}</span>
                        <a href="{{ logout_path() }}" class="btn btn-outline-secondary btn-sm">Log out</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="link-body-emphasis text-decoration-none">Log in</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm">Register</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main class="container pt-4 pb-5 flex-grow-1">
            {% block body %}{% endblock %}
        </main>

        <footer class="border-top">
            <div class="container py-3 d-flex justify-content-between flex-wrap gap-2 small text-body-secondary">
                <span>Data: <a href="https://www.football-data.org">football-data.org</a></span>
                <span>Eredivisie</span>
            </div>
        </footer>
    </body>
</html>
