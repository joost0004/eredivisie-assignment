{% extends 'base.html.twig' %}

{% block title %}My teams · Fulltime{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-4">
        <h1 class="mb-0">My teams</h1>
        {% if rows %}
            <a href="{{ path('app_team_index') }}" class="small">Follow more teams →</a>
        {% endif %}
    </div>

    {% if rows %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for row in rows %}
                {% set team = row.team %}
                {% set game = row.game %}
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <img class="object-fit-contain" src="{{ team.crestUrl }}" alt="" width="48" height="48">
                            <h2 class="h4 mb-0">{{ team.name }}</h2>
                        </div>
                        <div class="card-body border-top d-flex flex-column gap-2">
                            {% if game %}
                                <div class="small text-uppercase text-body-secondary">
                                    {{ row.played ? 'Last match' : 'No matches played yet · Next match' }}
                                </div>
                                <div class="d-flex justify-content-between align-items-center gap-3">
                                    <div class="overflow-hidden">
                                        {% set is_home = game.homeTeam.id == team.id %}
                                        <div class="fw-medium text-truncate">{{ is_home ? 'vs' : 'at' }} {{ is_home ? game.awayTeam.name : game.homeTeam.name }}</div>
                                        <div class="small text-body-secondary">{{ game.kickoffUtc|date('D j M') }} · MD {{ game.matchday }}</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        {% if row.played %}
                                            <span class="fs-4 fw-semibold">{{ game.homeScore }}–{{ game.awayScore }}</span>
                                            {% set result = game.resultFor(team) %}
                                            {{ include('game/_result_badge.html.twig') }}
                                        {% else %}
                                            <span class="fs-4 fw-semibold">{{ game.status.name == 'Scheduled' ? 'TBC' : game.kickoffUtc|date('H:i') }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="small text-body-secondary">No matches imported yet.</div>
                            {% endif %}
                            <a href="{{ path('app_team_show', {id: team.id}) }}" class="small mt-auto">Team page →</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="col-md-8 col-lg-6 mx-auto border text-center p-5">
            <h2>You're not following any teams yet</h2>
            <p class="text-body-secondary">Follow a team to see its latest result here.</p>
            <a href="{{ path('app_team_index') }}" class="btn btn-primary">Browse teams</a>
        </div>
    {% endif %}
{% endblock %}
