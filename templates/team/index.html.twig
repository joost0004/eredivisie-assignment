{% extends 'base.html.twig' %}

{% block title %}Teams · Fulltime{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-4">
        <h1 class="mb-0">Teams</h1>
        {% if teams %}
            <span class="small text-body-secondary">Eredivisie · {{ teams|length }} teams</span>
        {% endif %}
    </div>

    {% if teams %}
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
            {% for team in teams %}
                <div class="col">
                    <div class="card h-100 text-center">
                        <div class="card-body d-flex flex-column align-items-center gap-2">
                            <img class="object-fit-contain" src="{{ team.crestUrl }}" alt="" width="64" height="64">
                            <h2 class="h5 mb-0">
                                <a href="{{ path('app_team_show', {id: team.id}) }}" class="stretched-link link-body-emphasis text-decoration-none">{{ team.name }}</a>
                            </h2>
                            {% if app.user and app.user.isFollowing(team) %}
                                <span class="badge text-bg-primary mt-auto">✓ Following</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="col-md-8 col-lg-6 mx-auto border text-center p-5">
            <h2>No teams yet</h2>
            <p class="text-body-secondary">Team data hasn't been imported from football-data.org. Run the import, then reload this page.</p>
            <p><code>php bin/console app:import</code></p>
            <a href="{{ path('app_team_index') }}" class="btn btn-outline-secondary">Reload</a>
        </div>
    {% endif %}
{% endblock %}
